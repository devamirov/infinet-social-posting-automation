# InfiNet Automation - copy to .env and fill values

# Dashboard login (single user)
ADMIN_EMAIL=admin@infinet.services
ADMIN_PASSWORD_HASH=  # bcrypt hash of your password
SESSION_SECRET=        # random string for session

# Gemini (captions) - primary + fallback
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=

# OpenAI - TTS (voice for video)
OPENAI_API_KEY=

# Replicate - img2img (nano-banana) + video (SVD)
REPLICATE_API_TOKEN=

# Late API - posting (Instagram, Facebook, TikTok, Twitter)
LATE_API_KEY=

# Paths (absolute or relative to project)
BRAND_ASSETS_PATH=../ai.infinet.services,../infinet.services,../spectre.guru-OSINT-tool,../infinet.services:hosting,../InfiNetHub-MobileApp

# Late API account IDs (from GET https://getlate.dev/api/v1/accounts → use each account's _id)
LATE_ACCOUNT_INSTAGRAM=69861a4fc2419ab74f69bc55
LATE_ACCOUNT_FACEBOOK=69861a99c2419ab74f69bc7c
LATE_ACCOUNT_TIKTOK=69861b40c2419ab74f69bd56
LATE_ACCOUNT_TWITTER=69863190c2419ab74f69dc6d

# Optional: temp/output dirs
TEMP_DIR=./tmp
OUTPUT_DIR=./output
